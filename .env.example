# ================= Docker Compose 部署 =================

MYSQL_DATABASE=api_quality_guard
MYSQL_USER=aqg
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
REDIS_PASSWORD=change_me_redis

# 后端和 Agent 必须一致
AQG_INTERNAL_TOKEN=change_me_internal

# 首次启动自动创建的管理员（已有账号不会被覆盖）
AQG_ADMIN_USERNAME=admin
AQG_ADMIN_PASSWORD=change_me_admin

# 部署环境建议关闭开放注册
AQG_AUTH_REGISTRATION_ENABLED=false
# 把历史没有 owner_id 的业务数据归属到管理员
AQG_OWNER_BACKFILL_ENABLED=true

# OpenAI 兼容接口
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
AGENT_LLM_MOCK=false

HTTP_PORT=80
TZ=Asia/Shanghai


# ================= 本地开发 =================
# 本地后端使用 src/main/resources/application-local.yml 配置数据库账号；
# 下面变量供本地 Redis / 手工配置环境变量时参考

DB_HOST=localhost
DB_PORT=3306
DB_NAME=api_quality_guard
DB_USERNAME=aqg
DB_PASSWORD=change_me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
