{
  "openapi": "3.0.3",
  "info": {
    "title": "用户服务 API",
    "version": "1.2.0"
  },
  "servers": [
    { "url": "http://localhost:9090" }
  ],
  "paths": {
    "/users/{id}": {
      "get": {
        "operationId": "getUserById",
        "summary": "查询用户详情",
        "description": "根据用户 ID 查询用户信息",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户 ID",
            "schema": { "type": "integer", "minimum": 1, "maximum": 99999 }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "integer" },
                        "nickname": { "type": "string" }
                      },
                      "required": ["id"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "post": {
        "operationId": "createUser",
        "summary": "创建用户",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "minLength": 4, "maxLength": 20 },
                  "password": { "type": "string", "minLength": 6, "maxLength": 32 },
                  "age": { "type": "integer", "minimum": 0, "maximum": 150 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "id": { "type": "integer" } }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "查询用户列表",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "搜索关键词",
            "schema": { "type": "string", "minLength": 1, "maxLength": 50 }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1 }
          }
        ],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    },
    "/users/{id}/avatar": {
      "delete": {
        "operationId": "deleteAvatar",
        "summary": "删除用户头像",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "204": { "description": "删除成功" }
        }
      }
    }
  }
}
