{
  "swagger": "2.0",
  "info": {
    "title": "订单服务 API",
    "version": "0.9.0"
  },
  "host": "localhost:9091",
  "basePath": "/api",
  "schemes": ["http"],
  "produces": ["application/json"],
  "consumes": ["application/json"],
  "paths": {
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "summary": "查询订单",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "type": "integer",
            "minimum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "schema": {
              "type": "object",
              "properties": {
                "orderId": { "type": "integer" },
                "status": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "operationId": "createOrder",
        "summary": "创建订单",
        "consumes": ["application/json"],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["skuId", "quantity"],
              "properties": {
                "skuId": { "type": "integer" },
                "quantity": { "type": "integer", "minimum": 1, "maximum": 99 }
              }
            }
          }
        ],
        "responses": {
          "200": { "description": "成功" }
        }
      }
    }
  }
}
